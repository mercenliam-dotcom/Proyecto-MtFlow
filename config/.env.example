# Copiar como .env y completar. El archivo .env NUNCA se sube a Git.
DJANGO_DEBUG=1
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Sin DATABASE_URL (y con DJANGO_DEBUG=1) se usa SQLite local.
# Con PostgreSQL (docker compose up -d):
# DATABASE_URL=postgresql://mtflow:mtflow_dev@localhost:5432/mtflow

# Servicio de inferencia (debe ser la misma clave en ml_service)
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_API_KEY=cambiar-por-otra-clave-larga

# Producción (ejemplo):
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=mtflow.cl,www.mtflow.cl
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mtflow.cl,https://www.mtflow.cl
# DB_SSLMODE=require
# DJANGO_ADMIN_URL=una-ruta-dificil-de-adivinar/

# Solo activar detrás de un proxy controlado que reescriba los encabezados
# y no permita acceso directo al backend. Necesario para HTTPS terminado allí.
CONFIAR_EN_PROXY=0
# Estimador público: consultas por IP / ventana (segundos).
COTIZACION_MAX_INTENTOS=10
COTIZACION_VENTANA_SEGUNDOS=600

# Solo demostración local, nunca para el estudio real. Desactivado por defecto.
ADMIN_DESARROLLO_HABILITADO=0

# Solo para depurar: 1 muestra las páginas técnicas de Django (rutas, trazas). Nunca en producción.
MOSTRAR_ERRORES_TECNICOS=0
# Google/Facebook: vacíos deshabilitan el acceso externo. Nunca subir secretos.
SOCIAL_AUTH_BASE_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Versión habilitada en tu aplicación de Meta, con formato vNN.N.
FACEBOOK_API_VERSION=
