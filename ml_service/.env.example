# Copiar como ml_service/.env (no se sube a Git). La clave real va SOLO en .env.
# Misma clave que ML_SERVICE_API_KEY en config/.env
ML_SERVICE_API_KEY=cambiar-por-la-misma-clave-de-django

# Roboflow. La API key se obtiene en app.roboflow.com/settings/api
# (Private API Key de una cuenta con acceso al workspace). Es secreta.
ROBOFLOW_API_KEY=

# Workflow "Tattoo styles vtattoo-styles-2-resnet18-t1 Logic"
ROBOFLOW_WORKSPACE=martin-stgmar-gmail-com
ROBOFLOW_WORKFLOW_ID=tattoo-styles-vtattoo-styles-2-resnet18-t1-logic

# Solo para ML_PREDICTOR=roboflow_modelo (endpoint directo del modelo)
ROBOFLOW_MODEL_ID=martin-stgmar-gmail-com/tattoo-styles-2-resnet18-t1

# Modelo principal confirmado: EfficientNetB0 Keras, siete clases.
ML_PREDICTOR=local
MTFLOW_MODEL_DIR=modelos/efficientnet_b0_v2
# Exigencia fija del servicio: 0.60. E-99 es abstención, no una octava salida.
# Alternativas explícitas: roboflow_workflow, roboflow_modelo, local_pytorch, simulado, auto
# Opcionales: ROBOFLOW_TIMEOUT=15  ROBOFLOW_REINTENTOS=2
