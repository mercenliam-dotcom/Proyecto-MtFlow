# Copiar como ml_service/.env (no se sube a Git).
# Misma clave que ML_SERVICE_API_KEY en config/.env
ML_SERVICE_API_KEY=cambiar-por-la-misma-clave-de-django

# Modelo de Roboflow (proyecto "Tattoo styles").
# La API key se obtiene en Roboflow: Settings -> API Keys (Private API Key).
# Es secreta: solo va aquí, nunca en el navegador ni en Git.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=martin-stgmar-gmail-com/tattoo-styles-2-resnet18-t1

# auto = roboflow si hay ROBOFLOW_API_KEY; si no, simulado
ML_PREDICTOR=auto
