# Debe coincidir con ML_SERVICE_API_KEY de config/.env. No subir claves reales.
ML_SERVICE_API_KEY=cambiar-por-la-misma-clave-de-django
ML_PREDICTOR=local
MTFLOW_MODEL_DIR=modelos/efficientnet_b0_v3
MTFLOW_OOD_ENABLED=1
MTFLOW_OOD_CALIBRATION=modelos/efficientnet_b0_v3/ood/calibracion_ood_v3.json
# Umbral fijo 0.60. E-99 significa abstención, no una octava clase.
